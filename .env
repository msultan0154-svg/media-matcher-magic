# =============================================================================
# Shopify Image Sync — Custom App configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for the merchant's store.
# Every merchant gets their own .env (one deployment per store).
#
# NOTE for Lovable users: this project runs on Lovable, which does NOT read
# .env files. Instead, add each variable below as a Secret in
# Project Settings → Cloud → Secrets. The variable NAMES must match exactly.
# The .env file here is the source of truth when self-hosting (Vercel,
# Cloudflare, Fly.io, your own server, etc.).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SHOPIFY (required)
# -----------------------------------------------------------------------------
# Create a Custom App in the merchant's Shopify Admin:
#   Settings → Apps and sales channels → Develop apps → Create an app
#
# Required Admin API scopes:
#   read_products, write_products
#
# After installing, copy the Admin API access token (starts with "shpat_").

# The merchant's permanent store domain — always *.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from the Custom App install screen
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify Admin API version (optional — defaults to 2025-07)
SHOPIFY_API_VERSION=2025-07


# -----------------------------------------------------------------------------
# 2. GOOGLE DRIVE (required)
# -----------------------------------------------------------------------------
# This project currently uses Lovable's Google Drive connector via the
# Lovable connector gateway. If you self-host OUTSIDE Lovable, you must
# replace `driveFetch` in src/lib/shopify-sync.functions.ts with a real
# Google OAuth2 client (the gateway URL won't work outside Lovable).
#
# Inside Lovable, these are provided automatically when you connect Google
# Drive in Project Settings → Integrations. You normally do NOT set them
# by hand — they appear as Secrets after connection.

# Google Drive API key (provided by the Lovable Drive connector)
GOOGLE_DRIVE_API_KEY=

# Lovable AI / Connector Gateway key (provided by Lovable Cloud)
LOVABLE_API_KEY=
